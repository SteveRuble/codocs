{
  // Used by the editor and `npm run typecheck`: covers everything we author, emits nothing.
  // tsconfig.build.json narrows this to src/ and emits to dist/.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src", "prisma/seed.ts", "prisma.config.ts"]
}
