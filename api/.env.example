# Copy to .env (which is gitignored). Loaded by `node --env-file-if-exists=.env`
# and by prisma.config.ts (via dotenv). Validated at startup by src/config.ts.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origin of the Next.js frontend, allowed by CORS (required)
WEB_ORIGIN=http://localhost:3000
# SQLite database file; relative paths resolve from the folder you run the command in (api/) (required)
DATABASE_URL="file:./dev.db"
# HS256 key shared with the Next.js app (its API_JWT_SECRET); must be identical on both sides,
# 32+ characters (required). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_JWT_SECRET=
