# Copy to .env (which is gitignored). Loaded by `node --env-file-if-exists=.env`
# and by prisma.config.ts (via dotenv). Validated at startup by src/config.ts.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origin of the Next.js frontend, allowed by CORS (required)
WEB_ORIGIN=http://localhost:3000
# SQLite database file; relative paths resolve from the folder you run the command in (api/) (required)
DATABASE_URL="file:./dev.db"
