# Copy to .env.local and fill in.

# Secret used by Auth.js to encrypt its session cookie. Generate: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app credentials (see README).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared HS256 secret used to sign the short-lived API JWT. Must be identical to the Express API's secret.
API_JWT_SECRET=

# Base URL of the Express API (used in the browser).
NEXT_PUBLIC_API_URL=http://localhost:4000
